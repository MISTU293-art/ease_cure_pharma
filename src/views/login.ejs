<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Ease Cure Pharma</title>

    <!-- Bootstrap CSS -->
    <link
      href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.7/dist/css/bootstrap.min.css"
      rel="stylesheet"
    />
<style>
   *{
    margin:0;
    padding:0;
    box-sizing:border-box;
}

body{
    background:#f1f7ff;
    font-family:'Segoe UI',sans-serif;
}

.login-card{
    border:none;
    border-radius:18px;
    overflow:hidden;
    box-shadow:0 15px 35px rgba(0,0,0,.12);
}

.left-panel{
    background:linear-gradient(135deg,#2563EB,#1E40AF);
    color:white;
    display:flex;
    flex-direction:column;
    justify-content:center;
    align-items:center;
    padding:40px;
}

.left-panel img{
    width:180px;
    margin-bottom:25px;
}

.left-panel h2{
    font-weight:700;
}

.left-panel p{
    opacity:.9;
    text-align:center;
}

.right-panel{
    padding:50px;
    background:white;
}

.form-control{
    height:50px;
    border-radius:10px;
}

.form-control:focus{
    box-shadow:none;
    border-color:#2563EB;
}

.btn-login{
    background:#2563EB;
    color:white;
    height:50px;
    border:none;
    border-radius:10px;
    font-weight:600;
}

.btn-login:hover{
    background:#1E40AF;
}

</style>
    <!-- Bootstrap Bundle JS (includes Popper) -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.7/dist/js/bootstrap.bundle.min.js"></script>
  </head>
  <body>
    <div class="container py-5 justify-content-center mt-5">
<% if (error) { %>
  <div class="alert alert-danger alert-dismissible fade show" role="alert">
    <%= error %>
    <button
      type="button"
      class="btn-close"
      data-bs-dismiss="alert"
      aria-label="Close">
    </button>
  </div>
<% } %>
    <div class="row justify-content-center">

        <div class="col-lg-10">

            <div class="card login-card">

                <div class="row g-0">

                    <div class="col-md-5 left-panel">

                        <img src="/logo.png" alt="Logo">

                        <h2>Ease Cure Pharma</h2>

                        <p>
                            Pharmacy Management System
                        </p>

                        <small>
                            Inventory • Billing • Warehouse • Staff
                        </small>

                    </div>

                    <div class="col-md-7 right-panel">

                        <h3 class="fw-bold mb-2">
                            Welcome Back
                        </h3>

                        <p class="text-muted mb-4">
                            Login to continue
                        </p>

                        <form action="/login" method="post">

                            <div class="mb-3">

                                <label class="form-label">
                                    Username
                                </label>

                                <input
                                    type="text"
                                    class="form-control"
                                    placeholder="Enter Username"
                                    name="email"
                                    id="email"
                                >

                            </div>

                            <div class="mb-4">

                                <label class="form-label">
                                    Password
                                </label>

                                <input
                                    type="password"
                                    class="form-control"
                                    placeholder="Enter Password"
                                    name="password"
                                    id="password"
                                >

                            </div>

                            <button class="btn btn-login w-100">
                                Login
                            </button>

                        </form>

                    </div>

                </div>

            </div>

        </div>

    </div>

</div>
  </body>
</html>
