<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Customers | Ease Cure Pharma</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.7/dist/css/bootstrap.min.css" rel="stylesheet" />
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.13.1/font/bootstrap-icons.min.css" />
  <style>
    body {
      background: linear-gradient(135deg, #f8fbff 0%, #eef5ff 100%);
      font-family: 'Segoe UI', sans-serif;
    }
    .main-content {
      margin-left: 270px;
      padding: 30px;
    }
    .page-title {
      color: #1e3a8a;
      font-weight: 700;
    }
    .card {
      border: none;
      border-radius: 18px;
      box-shadow: 0 12px 35px rgba(37, 99, 235, 0.10);
    }
    .card-header {
      background: linear-gradient(135deg, #2563EB, #1d4ed8);
      color: #fff;
    }
    .search-box {
      border-radius: 999px;
      border: 1px solid #dbeafe;
      padding: 10px 15px;
    }
    .bill-badge {
      background: #e0f2fe;
      color: #0369a1;
      padding: 4px 8px;
      border-radius: 999px;
      font-size: 0.8rem;
      font-weight: 600;
    }
    .table thead {
      background: #eff6ff;
      color: #1e3a8a;
    }
    .badge-info {
      background: #dbeafe;
      color: #1d4ed8;
    }
    @media (max-width: 992px) {
      .main-content {
        margin-left: 0;
        margin-top: 70px;
        padding: 20px;
      }
    }
  </style>
</head>
<body>
  <%- include('./partials/sidebar.ejs') %>

  <div class="main-content">
    <div class="container-fluid">
      <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
          <h2 class="page-title"><i class="bi bi-people-fill me-2"></i>Customer Management</h2>
          <p class="text-muted mb-0">View customer records and recent purchases.</p>
        </div>
      </div>

      <div class="row g-4 mb-4">
        <div class="col-lg-4 col-md-6">
          <div class="card p-3">
            <div class="d-flex justify-content-between align-items-center">
              <div>
                <h6 class="text-muted mb-1">Total Customers</h6>
                <h3 class="mb-0"><%= customers && customers.length ? customers.length : 0 %></h3>
              </div>
              <div class="bg-primary text-white rounded-circle p-3">
                <i class="bi bi-people-fill fs-4"></i>
              </div>
            </div>
          </div>
        </div>

        <div class="col-lg-4 col-md-6">
          <div class="card p-3">
            <div class="d-flex justify-content-between align-items-center">
              <div>
                <h6 class="text-muted mb-1">Recent Orders</h6>
                <h3 class="mb-0"><%= customers && customers.length ? customers.length : 0 %></h3>
              </div>
              <div class="bg-success text-white rounded-circle p-3">
                <i class="bi bi-bag-check-fill fs-4"></i>
              </div>
            </div>
          </div>
        </div>

        <div class="col-lg-4 col-md-6">
          <div class="card p-3">
            <div class="d-flex justify-content-between align-items-center">
              <div>
                <h6 class="text-muted mb-1">Active Contacts</h6>
                <h3 class="mb-0"><%= customers && customers.length ? customers.length : 0 %></h3>
              </div>
              <div class="bg-warning text-dark rounded-circle p-3">
                <i class="bi bi-phone-fill fs-4"></i>
              </div>
            </div>
          </div>
        </div>
      </div>

      <% if (typeof error !== 'undefined' && error) { %>
        <div class="alert alert-danger"><i class="bi bi-exclamation-triangle-fill me-2"></i><%= error %></div>
      <% } %>

      <div class="card">
        <div class="card-header p-4 d-flex justify-content-between align-items-center">
          <h5 class="mb-0"><i class="bi bi-person-lines-fill me-2"></i>Customer List</h5>
          <div class="text-white-50 small">Search by customer, bill ID, or contact</div>
        </div>
        <div class="card-body">
          <div class="row g-3 mb-3">
            <div class="col-md-6">
              <input id="customerSearch" type="text" class="form-control search-box" placeholder="Search customer, bill, phone..." />
            </div>
            <div class="col-md-6 text-md-end">
              <span class="text-muted">Showing <strong id="visibleCount"><%= customers && customers.length ? customers.length : 0 %></strong> record(s)</span>
            </div>
          </div>
          <div class="table-responsive">
            <table class="table table-hover align-middle">
              <thead>
                <tr>
                  <th>#</th>
                  <th>Customer</th>
                  <th>Bill</th>
                  <th>Contact</th>
                  <th>Purchased Item</th>
                  <th>Qty</th>
                  <th>Amount</th>
                  <th>Payment</th>
                  <th>Seller</th>
                  <th>Date</th>
                  <th>Receipt</th>
                </tr>
              </thead>
              <tbody>
                <% if (customers && customers.length > 0) { %>
                  <% customers.forEach((customer, index) => { %>
                    <tr>
                      <td><%= index + 1 %></td>
                      <td>
                        <strong><%= customer.customer_name || customer.name || 'N/A' %></strong><br />
                        <small class="text-muted"><%= customer.address || 'N/A' %></small>
                      </td>
                      <td>
                        <span class="bill-badge"><%= customer.bill_id || 'N/A' %></span>
                      </td>
                      <td>
                        <i class="bi bi-phone me-1"></i><%= customer.mobile || 'N/A' %>
                      </td>
                      <td>
                        <strong><%= customer.medicine || 'N/A' %></strong>
                      </td>
                      <td><%= customer.quantity || '0' %></td>
                      <td>₹ <%= customer.amount || '0' %></td>
                      <td><%= customer.paymentMode || 'N/A' %></td>
                      <td><%= customer.seller || 'Ease Cure Pharma' %></td>
                      <td><%= customer.lastPurchase || 'No purchase yet' %></td>
                      <td>
                        <% if (customer.bill_id) { %>
                          <a href="/bills/<%= customer.bill_id %>.pdf" class="btn btn-sm btn-outline-primary" target="_blank">
                            <i class="bi bi-download me-1"></i>PDF
                          </a>
                        <% } else { %>
                          <span class="text-muted">—</span>
                        <% } %>
                      </td>
                    </tr>
                  <% }) %>
                <% } else { %>
                  <tr>
                    <td colspan="11" class="text-center text-muted py-4">
                      No customer records found yet. Generate a bill first to create customer data.
                    </td>
                  </tr>
                <% } %>
              </tbody>
            </table>
          </div>
        </div>
      </div>
    </div>
  </div>

  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.7/dist/js/bootstrap.bundle.min.js"></script>
  <script>
    const searchInput = document.getElementById('customerSearch');
    const visibleCount = document.getElementById('visibleCount');
    const rows = Array.from(document.querySelectorAll('tbody tr'));

    function filterRows() {
      const query = (searchInput?.value || '').toLowerCase().trim();
      let visible = 0;

      rows.forEach((row) => {
        const text = row.textContent.toLowerCase();
        const shouldShow = !query || text.includes(query);
        row.style.display = shouldShow ? '' : 'none';
        if (shouldShow) visible += 1;
      });

      if (visibleCount) visibleCount.textContent = visible;
    }

    searchInput?.addEventListener('input', filterRows);
    filterRows();
  </script>
</body>
</html>
