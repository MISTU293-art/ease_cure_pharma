<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">

<title>Medicine Inventory</title>

<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.7/dist/css/bootstrap.min.css" rel="stylesheet">
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.13.1/font/bootstrap-icons.min.css">

<style>

body{
    background:#f4f7fc;
    font-family:'Segoe UI',sans-serif;
}

.main-content{
    margin-left:270px;
    padding:30px;
}

@media(max-width:992px){

.main-content{
    margin-left:0;
    margin-top:70px;
    padding:20px;
}

}

.page-title{
    color:#1E3A8A;
    font-weight:700;
}

.card{

    border:none;

    border-radius:18px;

    box-shadow:0 10px 30px rgba(0,0,0,.08);

}

.card-header{

    background:#2563EB;

    color:#fff;

    padding:18px 25px;

}

.table thead{

    background:#2563EB;

    color:#fff;

}

.table tbody tr:hover{

    background:#eef4ff;

}

.badge-stock{

    background:#198754;

}

.badge-low{

    background:#ffc107;

    color:#000;

}

.badge-out{

    background:#dc3545;

}

.btn-action{

    width:36px;

    height:36px;

    display:flex;

    justify-content:center;

    align-items:center;

    border-radius:8px;

}

.search-box{

    border-radius:10px;

}

</style>

</head>

<body>

<%- include("./partials/sidebar.ejs") %>

<div class="main-content">
<% if(message){ %>

<div class="alert alert-success alert-dismissible fade show" role="alert">

    <i class="bi bi-check-circle-fill me-2"></i>

    <%= message %>

    <button
        type="button"
        class="btn-close"
        data-bs-dismiss="alert">
    </button>

</div>

<% } %>


<% if(error){ %>

<div class="alert alert-danger alert-dismissible fade show" role="alert">

    <i class="bi bi-exclamation-triangle-fill me-2"></i>

    <%= error %>

    <button
        type="button"
        class="btn-close"
        data-bs-dismiss="alert">
    </button>

</div>

<% } %>
<div class="container-fluid">

<div class="d-flex justify-content-between align-items-center mb-4">

<div>

<h2 class="page-title">

<i class="bi bi-capsule"></i>

Medicine Inventory / ওষুধের স্টক

</h2>

<p class="text-muted">

Manage all medicines in your pharmacy / সকল ওষুধ পরিচালনা করুন

</p>

</div>

<a href="/stock-add" class="btn btn-primary">

<i class="bi bi-plus-circle"></i>

নতুন ওষুধ যোগ করুন

</a>

</div>

<div class="card">

<div class="card-header">

<div class="row">

<div class="col-md-6">

<h5 class="mb-0">

<i class="bi bi-box-seam"></i>

Medicine List / ওষুধের তালিকা

</h5>

</div>

<div class="col-md-6">

<form class="d-flex" method="GET" action="/stock">

<input
    type="text"
    name="search"
    class="form-control search-box me-2"
    placeholder="ওষুধ/কোম্পানি/ব্যাচ লিখুন..."
    value="<%= typeof search !== 'undefined' ? search : '' %>">

<button class="btn btn-light" type="submit">

<i class="bi bi-search"></i>

</button>

</form>

</div>

</div>

</div>

<div class="card-body">

<div class="table-responsive">

<table class="table table-hover align-middle">

<thead>

<tr>

<th>#</th>
<th>Medicine</th>
<th>Company</th>
<th>Category</th>
<th>Batch</th>
<th>Qty</th>
<th>Purchase</th>
<th>Selling</th>
<th>Expiry</th>
<th>Status</th>
<th>Action</th>

</tr>

</thead>

<tbody>

<% if(stocks.length===0){ %>

<tr>

<td colspan="11" class="text-center">

No Medicines Found

</td>

</tr>

<% } %>

<% stocks.forEach((stock,index)=>{ %>

<tr>

<td>

<%= ((currentPage || 1)-1)*10 + index +1 %>

</td>

<td><strong><%= stock.name %></strong></td>

<td><%= stock.manufacturer %></td>

<td><%= stock.category %></td>

<td><%= stock.batchNumber %></td>

<td><%= stock.quantity %></td>

<td>₹ <%= stock.purchasePrice %></td>

<td>₹ <%= stock.sellingPrice %></td>

<td>

<%= new Date(stock.expiryDate).toLocaleDateString() %>

</td>

<td>

<% if(stock.quantity>20){ %>

<span class="badge bg-success">

স্টকে আছে

</span>

<% }else if(stock.quantity>0){ %>

<span class="badge bg-warning text-dark">

কম স্টক

</span>

<% }else{ %>

<span class="badge bg-danger">

স্টক শেষ

</span>

<% } %>

</td>

<td>

<a href="/stock/edit/<%= stock._id %>" class="btn btn-warning btn-sm">

<i class="bi bi-pencil"></i>

</a>

<a href="/stock/delete/<%= stock._id %>"
class="btn btn-danger btn-sm"
onclick="return confirm('আপনি কি নিশ্চিত?')">

<i class="bi bi-trash"></i>

</a>

</td>

</tr>

<% }) %>

</tbody>

</table>

</div>

<div class="d-flex justify-content-between align-items-center mt-3">

<p class="text-muted mb-0">
    <% if(typeof search !== 'undefined' && search){ %>
        Showing <%= stocks.length %> result(s) for "<%= search %>" on page <%= currentPage %> of <%= totalPages %>
    <% } else { %>
        Showing <%= stocks.length %> medicines on page <%= currentPage %> of <%= totalPages %>
    <% } %>
</p>

<% if(typeof totalPages !== 'undefined' && totalPages > 1){ %>

<nav aria-label="Stock pagination">

    <ul class="pagination pagination-sm mb-0">

        <li class="page-item <%= currentPage <= 1 ? 'disabled' : '' %>">
            <a class="page-link" href="/stock?<%= typeof search !== 'undefined' && search ? 'search=' + encodeURIComponent(search) + '&' : '' %>page=<%= currentPage - 1 %>">Previous</a>
        </li>

        <% for(let i = 1; i <= totalPages; i++){ %>

        <li class="page-item <%= currentPage === i ? 'active' : '' %>">
            <a class="page-link" href="/stock?<%= typeof search !== 'undefined' && search ? 'search=' + encodeURIComponent(search) + '&' : '' %>page=<%= i %>"><%= i %></a>
        </li>

        <% } %>

        <li class="page-item <%= currentPage >= totalPages ? 'disabled' : '' %>">
            <a class="page-link" href="/stock?<%= typeof search !== 'undefined' && search ? 'search=' + encodeURIComponent(search) + '&' : '' %>page=<%= currentPage + 1 %>">Next</a>
        </li>

    </ul>

</nav>

<% } %>

</div>

</div>

</div>

</div>

</div>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.7/dist/js/bootstrap.bundle.min.js"></script>

</body>
</html>