<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">

<title>Dashboard | Ease Cure Pharma</title>

<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.7/dist/css/bootstrap.min.css" rel="stylesheet">
<link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" rel="stylesheet">

<style>

body{
    background:#f4f7fc;
    font-family:'Segoe UI',sans-serif;
}

/* Main Content */

.main-content{
    margin-left:270px;
    padding:30px;
}

/* Welcome */

.welcome-card{
    background:linear-gradient(135deg,#2563EB,#1D4ED8);
    color:#fff;
    border:none;
    border-radius:20px;
    box-shadow:0 10px 25px rgba(37,99,235,.25);
}

/* Cards */

.dashboard-card{
    border:none;
    border-radius:18px;
    transition:.3s;
    box-shadow:0 10px 25px rgba(0,0,0,.06);
}

.dashboard-card:hover{
    transform:translateY(-5px);
}

.icon-box{
    width:60px;
    height:60px;
    border-radius:15px;
    display:flex;
    justify-content:center;
    align-items:center;
    color:#fff;
    font-size:26px;
}

.bg-blue{
    background:#2563EB;
}

.bg-green{
    background:#10B981;
}

.bg-orange{
    background:#F59E0B;
}

.bg-red{
    background:#EF4444;
}

.table-card{
    border:none;
    border-radius:18px;
}

.badge-stock{
    background:#fee2e2;
    color:#dc2626;
}

.badge-safe{
    background:#dcfce7;
    color:#16a34a;
}

@media(max-width:992px){

.main-content{
margin-left:0;
padding:20px;
}

}

</style>

</head>

<body>

<%- include('./partials/sidebar.ejs') %>

<div class="main-content">

<div class="container-fluid">

<!-- Welcome -->

<div class="card welcome-card mb-4">

<div class="card-body">

<h1 class="text-white">Welcome, <%= user && user.name ? user.name : 'Admin' %></h1>

<p class="mb-0 text-white">
Manage medicines, inventory and staff from one place.
</p>

</div>

</div>

<!-- Statistics -->

<div class="row g-4">

<div class="col-lg-3 col-md-6">

<div class="card dashboard-card">

<div class="card-body d-flex justify-content-between align-items-center">

<div>

<h6 class="text-muted">Total Users</h6>

<h3><%= totalUsers %></h3>

<small class="text-success">
Registered accounts
</small>

</div>

<div class="icon-box bg-blue">

<i class="bi bi-people-fill"></i>

</div>

</div>

</div>

</div>

<div class="col-lg-3 col-md-6">

<div class="card dashboard-card">

<div class="card-body d-flex justify-content-between align-items-center">

<div>

<h6 class="text-muted">Staff Members</h6>

<h3><%= totalStaff %></h3>

<small class="text-success">
Active team members
</small>

</div>

<div class="icon-box bg-green">

<i class="bi bi-person-badge-fill"></i>

</div>

</div>

</div>

</div>

<div class="col-lg-3 col-md-6">

<div class="card dashboard-card">

<div class="card-body d-flex justify-content-between align-items-center">

<div>

<h6 class="text-muted">Medicines</h6>

<h3><%= totalMedicines %></h3>

<small class="text-primary">
Stock entries
</small>

</div>

<div class="icon-box bg-orange">

<i class="bi bi-capsule"></i>

</div>

</div>

</div>

</div>

<div class="col-lg-3 col-md-6">

<div class="card dashboard-card">

<div class="card-body d-flex justify-content-between align-items-center">

<div>

<h6 class="text-muted">Low Stock</h6>

<h3><%= lowStockCount %></h3>

<small class="text-danger">
Need refill soon
</small>

</div>

<div class="icon-box bg-red">

<i class="bi bi-exclamation-triangle"></i>

</div>

</div>

</div>

</div>

</div>

<!-- Tables -->

<div class="row mt-4">

<div class="col-lg-8">

<div class="card table-card shadow-sm">

<div class="card-header bg-white">

<h5 class="mb-0">

<i class="bi bi-person-lines-fill me-2"></i>

Recent Staff

</h5>

</div>

<div class="card-body">

<div class="table-responsive">

<table class="table table-hover">

<thead>

<tr>

<th>Name</th>

<th>Role</th>
</tr>

</thead>

<tbody>

<% if(recentStaff && recentStaff.length > 0){ %>

<% recentStaff.forEach((staff)=>{ %>

<tr>

<td><%= staff.name %></td>

<td><%= staff.role %></td>



</tr>

<% }) %>

<% } else { %>

<tr>

<td colspan="3" class="text-center text-muted">No staff records found.</td>

</tr>

<% } %>

</tbody>

</table>

</div>

</div>

</div>

</div>

<div class="col-lg-4">

<div class="card table-card shadow-sm">

<div class="card-header bg-white">

<h5>

<i class="bi bi-capsule me-2"></i>

Medicine Stock

</h5>

</div>

<div class="card-body">

<% if(stockSummary && stockSummary.length > 0){ %>

<% stockSummary.forEach((item)=>{ %>

<div class="d-flex justify-content-between mb-3">

<span><%= item.name %></span>

<span class="badge <%= Number(item.quantity) <= 10 ? 'badge-stock' : 'badge-safe' %>">

<%= item.quantity %> Left

</span>

</div>

<% }) %>

<% } else { %>

<p class="text-muted mb-0">No stock items found.</p>

<% } %>

</div>

</div>

</div>

</div>

<!-- Bottom Cards -->

<div class="row mt-4">

<div class="col-lg-6">

<div class="card dashboard-card">

<div class="card-header bg-white">

<h5>

<i class="bi bi-bell-fill me-2"></i>

Notifications

</h5>

</div>

<div class="card-body">

<p>🔔 <%= lowStockCount %> medicines are currently low on stock.</p>

<p>📦 <%= totalMedicines %> medicine records are available in inventory.</p>

<p>👨‍⚕️ <%= recentStaff && recentStaff.length > 0 ? recentStaff[0].name : 'No staff' %> is the latest staff account added.</p>

</div>

</div>

</div>

<div class="col-lg-6">

<div class="card dashboard-card">

<div class="card-header bg-white">

<h5>

<i class="bi bi-person-workspace me-2"></i>

Staff Activity

</h5>

</div>

<div class="card-body">

<p>👨‍⚕️ <%= totalStaff %> staff members are currently registered.</p>

<p>💊 Inventory data is being pulled from the stock records.</p>

<p>🧾 <%= totalUsers %> user accounts are available in the system.</p>

</div>

</div>

</div>

</div>

</div>

</div>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.7/dist/js/bootstrap.bundle.min.js"></script>

</body>
</html>