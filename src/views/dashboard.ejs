<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">

<title>Dashboard | Ease Cure Pharma</title>

<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.7/dist/css/bootstrap.min.css" rel="stylesheet">
<link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" rel="stylesheet">

<style>

body{
    background:#f4f7fc;
    font-family:'Segoe UI',sans-serif;
}

/* Main Content */

.main-content{
    margin-left:270px;
    padding:30px;
}

/* Welcome */

.welcome-card{
    background:linear-gradient(135deg,#2563EB,#1D4ED8);
    color:#fff;
    border:none;
    border-radius:20px;
    box-shadow:0 10px 25px rgba(37,99,235,.25);
}

/* Cards */

.dashboard-card{
    border:none;
    border-radius:18px;
    transition:.3s;
    box-shadow:0 10px 25px rgba(0,0,0,.06);
}

.dashboard-card:hover{
    transform:translateY(-5px);
}

.icon-box{
    width:60px;
    height:60px;
    border-radius:15px;
    display:flex;
    justify-content:center;
    align-items:center;
    color:#fff;
    font-size:26px;
}

.bg-blue{
    background:#2563EB;
}

.bg-green{
    background:#10B981;
}

.bg-orange{
    background:#F59E0B;
}

.bg-red{
    background:#EF4444;
}

.table-card{
    border:none;
    border-radius:18px;
}

.badge-stock{
    background:#fee2e2;
    color:#dc2626;
}

.badge-safe{
    background:#dcfce7;
    color:#16a34a;
}

@media(max-width:992px){

.main-content{
margin-left:0;
padding:20px;
}

}

</style>

</head>

<body>

<%- include('./partials/sidebar.ejs') %>

<div class="main-content">

<div class="container-fluid">

<!-- Welcome -->

<div class="card welcome-card mb-4">

<div class="card-body">

<h1>Welcome, <%= user.name %></h1>

<p class="mb-0">
Manage medicines, billing, customers, inventory and staff from one place.
</p>

</div>

</div>

<!-- Statistics -->

<div class="row g-4">

<div class="col-lg-3 col-md-6">

<div class="card dashboard-card">

<div class="card-body d-flex justify-content-between align-items-center">

<div>

<h6 class="text-muted">Today's Sales</h6>

<h3>$2,450</h3>

<small class="text-success">
<i class="bi bi-arrow-up"></i>
12% Today
</small>

</div>

<div class="icon-box bg-blue">

<i class="bi bi-cash-stack"></i>

</div>

</div>

</div>

</div>

<div class="col-lg-3 col-md-6">

<div class="card dashboard-card">

<div class="card-body d-flex justify-content-between align-items-center">

<div>

<h6 class="text-muted">Customers</h6>

<h3>548</h3>

<small class="text-success">
+15 New
</small>

</div>

<div class="icon-box bg-green">

<i class="bi bi-people-fill"></i>

</div>

</div>

</div>

</div>

<div class="col-lg-3 col-md-6">

<div class="card dashboard-card">

<div class="card-body d-flex justify-content-between align-items-center">

<div>

<h6 class="text-muted">Medicines</h6>

<h3>1,240</h3>

<small class="text-primary">
Available
</small>

</div>

<div class="icon-box bg-orange">

<i class="bi bi-capsule"></i>

</div>

</div>

</div>

</div>

<div class="col-lg-3 col-md-6">

<div class="card dashboard-card">

<div class="card-body d-flex justify-content-between align-items-center">

<div>

<h6 class="text-muted">Low Stock</h6>

<h3>17</h3>

<small class="text-danger">
Need Refill
</small>

</div>

<div class="icon-box bg-red">

<i class="bi bi-exclamation-triangle"></i>

</div>

</div>

</div>

</div>

</div>

<!-- Tables -->

<div class="row mt-4">

<div class="col-lg-8">

<div class="card table-card shadow-sm">

<div class="card-header bg-white">

<h5 class="mb-0">

<i class="bi bi-receipt me-2"></i>

Recent Bills

</h5>

</div>

<div class="card-body">

<div class="table-responsive">

<table class="table table-hover">

<thead>

<tr>

<th>Bill ID</th>

<th>Customer</th>

<th>Amount</th>

<th>Status</th>

</tr>

</thead>

<tbody>

<tr>

<td>#1001</td>

<td>John Smith</td>

<td>$54</td>

<td><span class="badge bg-success">Paid</span></td>

</tr>

<tr>

<td>#1002</td>

<td>Emma Watson</td>

<td>$89</td>

<td><span class="badge bg-success">Paid</span></td>

</tr>

<tr>

<td>#1003</td>

<td>David Lee</td>

<td>$42</td>

<td><span class="badge bg-warning">Pending</span></td>

</tr>

<tr>

<td>#1004</td>

<td>Sarah Roy</td>

<td>$112</td>

<td><span class="badge bg-success">Paid</span></td>

</tr>

</tbody>

</table>

</div>

</div>

</div>

</div>

<div class="col-lg-4">

<div class="card table-card shadow-sm">

<div class="card-header bg-white">

<h5>

<i class="bi bi-capsule me-2"></i>

Medicine Stock

</h5>

</div>

<div class="card-body">

<div class="d-flex justify-content-between mb-3">

<span>Paracetamol</span>

<span class="badge badge-safe">

120 Left

</span>

</div>

<div class="d-flex justify-content-between mb-3">

<span>Vitamin C</span>

<span class="badge badge-safe">

82 Left

</span>

</div>

<div class="d-flex justify-content-between mb-3">

<span>Amoxicillin</span>

<span class="badge badge-stock">

9 Left

</span>

</div>

<div class="d-flex justify-content-between mb-3">

<span>Insulin</span>

<span class="badge badge-stock">

4 Left

</span>

</div>

<div class="d-flex justify-content-between">

<span>Cough Syrup</span>

<span class="badge badge-safe">

45 Left

</span>

</div>

</div>

</div>

</div>

</div>

<!-- Bottom Cards -->

<div class="row mt-4">

<div class="col-lg-6">

<div class="card dashboard-card">

<div class="card-header bg-white">

<h5>

<i class="bi bi-bell-fill me-2"></i>

Notifications

</h5>

</div>

<div class="card-body">

<p>🔔 3 medicines will expire in the next 7 days.</p>

<p>📦 2 suppliers delivered today's orders.</p>

<p>👨‍⚕️ New customer registered today.</p>

</div>

</div>

</div>

<div class="col-lg-6">

<div class="card dashboard-card">

<div class="card-header bg-white">

<h5>

<i class="bi bi-person-workspace me-2"></i>

Staff Activity

</h5>

</div>

<div class="card-body">

<p>👨‍⚕️ Alex generated 15 bills today.</p>

<p>💊 Emma updated medicine inventory.</p>

<p>🧾 John completed today's purchase entry.</p>

</div>

</div>

</div>

</div>

</div>

</div>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.7/dist/js/bootstrap.bundle.min.js"></script>

</body>
</html>