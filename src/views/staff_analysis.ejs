<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Staff Login Details</title>

    <!-- Bootstrap CSS + Icons (required by this page and by the sidebar partial) -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.7/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css">

    <style>
        :root {
            --brand: #2563eb;
            --brand-soft: #e8f0ff;
            --ink: #1f2937;
            --muted: #6b7280;
            --border: #e5e7eb;
        }

        * { box-sizing: border-box; }

        body {
            background: #f5f7fb;
            font-family: "Segoe UI", Arial, sans-serif;
            color: var(--ink);
        }

        /* Mobile top bar (hidden on desktop) */
        .mobile-topbar {
            display: none;
            align-items: center;
            gap: 12px;
            background: #ffffff;
            border-bottom: 1px solid var(--border);
            padding: 12px 16px;
            position: sticky;
            top: 0;
            z-index: 1030;
        }

        .mobile-topbar .brand-name {
            font-weight: 700;
            font-size: 1.05rem;
            color: var(--ink);
        }

        .mobile-topbar button {
            border: none;
            background: var(--brand-soft);
            color: var(--brand);
            width: 40px;
            height: 40px;
            border-radius: 10px;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            font-size: 1.1rem;
        }

        .content-wrapper {
            margin-left: 250px;
            padding: 28px;
            width: calc(100% - 250px);
        }

        .page-card {
            background: #ffffff;
            border-radius: 14px;
            box-shadow: 0 4px 18px rgba(0, 0, 0, 0.06);
            border: 1px solid var(--border);
            padding: 24px;
            overflow-x: auto;
        }

        .page-header {
            display: flex;
            justify-content: space-between;
            align-items: flex-start;
            flex-wrap: wrap;
            gap: 12px;
            margin-bottom: 18px;
        }

        .page-icon {
            width: 44px;
            height: 44px;
            border-radius: 12px;
            background: var(--brand-soft);
            color: var(--brand);
            display: inline-flex;
            align-items: center;
            justify-content: center;
            font-size: 1.2rem;
            margin-bottom: 10px;
        }

        .page-title {
            font-size: 1.35rem;
            font-weight: 700;
            color: var(--ink);
            margin-bottom: 4px;
        }

        .page-subtitle {
            color: var(--muted);
            font-size: 0.95rem;
            margin-bottom: 0;
        }

        .badge-soft {
            background: var(--brand-soft);
            color: var(--brand);
            padding: 7px 14px;
            border-radius: 999px;
            font-size: 0.85rem;
            font-weight: 600;
            white-space: nowrap;
            display: inline-flex;
            align-items: center;
            gap: 6px;
        }

        .table {
            margin-bottom: 0;
        }

        .table thead th {
            background: #f8fafc;
            color: #374151;
            font-size: 0.82rem;
            text-transform: uppercase;
            letter-spacing: 0.04em;
            border-bottom: 1px solid var(--border);
            padding: 12px 14px;
            white-space: nowrap;
        }

        .table tbody td {
            padding: 14px;
            font-size: 0.92rem;
            vertical-align: middle;
            border-bottom: 1px solid #f1f2f4;
        }

        .table tbody tr:last-child td {
            border-bottom: none;
        }

        .table tbody tr:hover {
            background: #fafbff;
        }

        .staff-cell {
            display: flex;
            align-items: center;
            gap: 10px;
        }

        .avatar-initial {
            width: 34px;
            height: 34px;
            border-radius: 50%;
            background: var(--brand-soft);
            color: var(--brand);
            font-weight: 700;
            font-size: 0.85rem;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            flex-shrink: 0;
        }

        .staff-name {
            font-weight: 600;
            color: var(--ink);
        }

        .ip-pill {
            background: #f3f4f6;
            color: #374151;
            padding: 4px 10px;
            border-radius: 8px;
            font-family: "SFMono-Regular", Consolas, monospace;
            font-size: 0.85rem;
        }

        .empty-state, .error-state {
            text-align: center;
            padding: 48px 20px;
            color: var(--muted);
        }

        .empty-state i {
            font-size: 2.2rem;
            color: #c7cdd6;
            margin-bottom: 12px;
            display: block;
        }

        .error-state {
            background: #fef2f2;
            border: 1px solid #fecaca;
            border-radius: 12px;
            color: #b91c1c;
        }

        .error-state i {
            font-size: 1.6rem;
            margin-bottom: 8px;
            display: block;
        }

        @media (max-width: 992px) {
            .mobile-topbar {
                display: flex;
            }

            .content-wrapper {
                margin-left: 0;
                width: 100%;
                padding: 16px;
            }

            .page-card {
                padding: 16px;
                border-radius: 12px;
            }
        }

        @media (max-width: 576px) {
            .page-title {
                font-size: 1.1rem;
            }

            .page-subtitle {
                font-size: 0.88rem;
            }

            .badge-soft {
                width: 100%;
                justify-content: center;
            }

            .table thead th,
            .table tbody td {
                font-size: 0.85rem;
                white-space: nowrap;
            }
        }
    </style>
</head>
<body>
    <%- include('./partials/sidebar.ejs') %>

    <!-- Mobile top bar with sidebar trigger -->
    <div class="mobile-topbar d-lg-none">
        <button type="button" data-bs-toggle="offcanvas" data-bs-target="#mobileSidebar" aria-label="Open menu">
            <i class="bi bi-list"></i>
        </button>
        <span class="brand-name">Ease Cure Pharma</span>
    </div>

    <div class="content-wrapper">
        <div class="page-card">
            <div class="page-header">
                <div>
                    <div class="page-icon"><i class="bi bi-graph-up"></i></div>
                    <h3 class="page-title">Staff Login Activity</h3>
                    <p class="page-subtitle">View staff login records with the IP address and timestamp.</p>
                </div>
                <% if (loginLogs && loginLogs.length > 0) { %>
                    <span class="badge-soft">
                        <i class="bi bi-clock-history"></i>
                        <%= loginLogs.length %> login record<%= loginLogs.length === 1 ? '' : 's' %>
                    </span>
                <% } %>
            </div>

            <% if (error) { %>
                <div class="error-state">
                    <i class="bi bi-exclamation-triangle"></i>
                    <%= error %>
                </div>
            <% } else if (loginLogs && loginLogs.length > 0) { %>
                <div class="table-responsive">
                    <table class="table">
                        <thead>
                            <tr>
                                <th>Staff Name</th>
                                <th>Email</th>
                                <th>Login IP</th>
                                <th>Login Time</th>
                            </tr>
                        </thead>
                        <tbody>
                            <% loginLogs.forEach(function(log) {
                                var name = (log.user && log.user.name) ? log.user.name : 'Unknown staff';
                                var initial = name.charAt(0).toUpperCase();
                            %>
                                <tr>
                                    <td>
                                        <div class="staff-cell">
                                            <span class="avatar-initial"><%= initial %></span>
                                            <span class="staff-name"><%= name %></span>
                                        </div>
                                    </td>
                                    <td><%= (log.user && log.user.email) ? log.user.email : '-' %></td>
                                    <td><span class="ip-pill"><%= log.ip || 'N/A' %></span></td>
                                    <td><%= log.logged_at ? new Date(log.logged_at).toLocaleString() : '-' %></td>
                                </tr>
                            <% }); %>
                        </tbody>
                    </table>
                </div>
            <% } else { %>
                <div class="empty-state">
                    <i class="bi bi-inbox"></i>
                    No login records found yet.
                </div>
            <% } %>
        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.7/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
