<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Staff Management</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.7/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.13.1/font/bootstrap-icons.min.css">

    <style>
        body {
            margin: 0;
            background: #f5f7fb;
            overflow-x: hidden;
            font-family: Arial, Helvetica, sans-serif;
        }

        /* Main Content */
        .main-content {
            margin-left: 260px;
            padding: 30px;
            transition: .3s ease;
        }

        /* Card */
        .card {
            border: none;
            border-radius: 18px;
            box-shadow: 0 10px 25px rgba(0, 0, 0, .08);
        }

        /* Header */
        .page-title {
            font-weight: 700;
            margin-bottom: 5px;
        }

        /* Table */
        .table {
            margin-bottom: 0;
        }

        .table thead th {
            background: #0d6efd;
            color: #fff;
            border: none;
            white-space: nowrap;
        }

        .table td,
        .table th {
            vertical-align: middle;
            white-space: nowrap;
        }

        .table tbody tr:hover {
            background: #eef5ff;
        }

        /* Avatar */
        .avatar {
            width: 45px;
            height: 45px;
            border-radius: 50%;
            object-fit: cover;
        }

        /* Action Buttons */
        .btn-action {
            width: 36px;
            height: 36px;
            display: flex;
            justify-content: center;
            align-items: center;
            padding: 0;
        }

        /* Tablet */
        @media (max-width:992px) {

            .main-content {
                margin-left: 0;
                padding: 20px;
            }

        }

        /* Mobile */
        @media (max-width:576px) {

            .main-content {
                padding: 15px;
            }

            .header-section {
                flex-direction: column;
                align-items: flex-start !important;
                gap: 15px;
            }

            .header-section .btn {
                width: 100%;
            }

            .page-title {
                font-size: 1.5rem;
            }

            .avatar {
                width: 38px;
                height: 38px;
            }

            .table {
                font-size: .9rem;
            }

            .btn-action {
                width: 32px;
                height: 32px;
            }
        }
    </style>
</head>

<body>

    <!-- Sidebar -->
    <%- include("./partials/sidebar.ejs") %>

        <!-- Main Content -->
        <main class="main-content">

            <div class="container-fluid">

                <!-- Header -->
                <div class="d-flex justify-content-between align-items-center mb-4 header-section">

                    <div>
                        <h2 class="page-title">Staff Management</h2>
                        <p class="text-muted mb-0">
                            Manage all pharmacy staff members
                        </p>
                    </div>

                    <a href="/add-staff" class="btn btn-primary">
                        <i class="bi bi-plus-circle me-2"></i>
                        Add Staff
                    </a>

                </div>

                <!-- Table Card -->
                <div class="card">

                    <div class="card-body">

                        <div class="table-responsive">

                            <table class="table table-hover align-middle">

                                <thead>
                                    <tr>
                                        <th>#</th>
                                        <th>Staff</th>
                                        <th>Email</th>
                                        <th>Role</th>
                                        <th>Salary</th>
                                        <th>Status</th>
                                        <th class="text-center">Actions</th>
                                    </tr>
                                </thead>

                                <tbody>

                                    <% staffs.forEach((staff,index)=>{ %>

                                        <tr>

                                            <td>
                                                <%= index + 1 %>
                                            </td>

                                            <td>
                                                <div class="d-flex align-items-center">

                                                    <img src="https://ui-avatars.com/api/?name=<%= staff.name %>&background=0D6EFD&color=fff"
                                                        class="avatar me-3" alt="<%= staff.name %>">

                                                    <div>
                                                        <strong>
                                                            <%= staff.name %>
                                                        </strong><br>
                                                        <small class="text-muted">
                                                            ID: <%= staff._id %>
                                                        </small>
                                                    </div>

                                                </div>
                                            </td>

                                            <td>
                                                <%= staff.email %>
                                            </td>

                                            <td>
                                                <% if(staff.role==="admin" ){ %>

                                                    <span class="badge bg-danger">
                                                        Admin
                                                    </span>

                                                    <% } else { %>

                                                        <span class="badge bg-success">
                                                        <%=staff.role%>
                                                        </span>

                                                        <% } %>
                                            </td>

                                            <td>₹ <%= staff.salary %>
                                            </td>

                                            <td>
                                                <span class="badge bg-success">
                                                    Active
                                                </span>
                                            </td>

                                            <td>

                                                <div class="d-flex justify-content-center gap-2">

                                                    <a href="/staff/<%= staff._id %>"
                                                        class="btn btn-outline-primary btn-sm btn-action">
                                                        <i class="bi bi-eye"></i>
                                                    </a>

                                                    <a href="/staff/edit/<%= staff._id %>"
                                                        class="btn btn-outline-warning btn-sm btn-action">
                                                        <i class="bi bi-pencil"></i>
                                                    </a>

                                                    <a href="/staff/delete/<%= staff._id %>"
                                                        class="btn btn-outline-danger btn-sm btn-action"
                                                        onclick="return confirm('Delete this staff?')">
                                                        <i class="bi bi-trash"></i>
                                                    </a>

                                                </div>

                                            </td>

                                        </tr>

                                        <% }) %>

                                </tbody>

                            </table>

                        </div>

                    </div>

                </div>

            </div>

        </main>

</body>

</html>