
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Profile Settings</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.7/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" rel="stylesheet">

    <style>
        body{
            background:#f4f7fc;
        }

        .main-content{
            margin-left:270px;
            padding:40px 20px;
        }

        @media(max-width:992px){
            .main-content{
                margin-left:0;
                padding:20px;
            }
        }

        .profile-card,
        .password-card{
            max-width:700px;
            margin:0 auto 30px;
            border:none;
            border-radius:18px;
            overflow:hidden;
            box-shadow:0 10px 25px rgba(0,0,0,.08);
        }

        .profile-header{
            background:linear-gradient(135deg,#2563eb,#1d4ed8);
            color:#fff;
            text-align:center;
            padding:35px 20px;
        }

        .avatar{
            width:90px;
            height:90px;
            border-radius:50%;
            background:#fff;
            color:#2563eb;
            display:flex;
            align-items:center;
            justify-content:center;
            font-size:40px;
            margin:0 auto 15px;
        }

        .profile-body{
            padding:30px;
        }

        .info-item{
            display:flex;
            justify-content:space-between;
            align-items:center;
            padding:15px 0;
            border-bottom:1px solid #ececec;
        }

        .info-item:last-child{
            border-bottom:none;
        }

        .info-label{
            font-weight:600;
            color:#6c757d;
        }

        .info-value{
            font-weight:500;
            color:#212529;
        }

        .password-card .card-header{
            background:#fff;
            font-size:1.2rem;
            font-weight:600;
            border-bottom:1px solid #e9ecef;
            padding:18px 25px;
        }

        .password-card .card-body{
            padding:25px;
        }

        .form-control{
            height:48px;
            border-radius:10px;
        }

        .btn-primary{
            height:48px;
            border-radius:10px;
            font-weight:600;
        }
    </style>
</head>
<body>

<%- include('./partials/sidebar.ejs') %>

<div class="main-content">

    <!-- Profile Card -->
    <div class="card profile-card">

        <div class="profile-header">
            <div class="avatar">
                <i class="bi bi-person-fill"></i>
            </div>

            <h3><%= profile.name %></h3>
            <p class="mb-0">Profile Information</p>
        </div>

        <div class="profile-body">

            <div class="info-item">
                <span class="info-label">
                    <i class="bi bi-person me-2"></i>Name
                </span>

                <span class="info-value">
                    <%= profile.name %>
                </span>
            </div>

            <div class="info-item">
                <span class="info-label">
                    <i class="bi bi-envelope me-2"></i>Email
                </span>

                <span class="info-value">
                    <%= profile.email %>
                </span>
            </div>

            <div class="info-item">
                <span class="info-label">
                    <i class="bi bi-shield-check me-2"></i>Role
                </span>

                <span class="badge bg-primary">
                    <%= profile.role %>
                </span>
            </div>

            <div class="text-end mt-4">
                <a href="/settings/edit" class="btn btn-primary">
                    <i class="bi bi-pencil-square me-2"></i>
                    Edit Profile
                </a>
            </div>

        </div>

    </div>

    <!-- Change Password Card -->
    <div class="card password-card">

        <div class="card-header">
            <i class="bi bi-lock-fill text-primary me-2"></i>
            Change Password
        </div>

        <div class="card-body">

            <form action="/change-password" method="POST">

                <div class="mb-3">
                    <label class="form-label" for="password">
                        Current Password
                    </label>

                    <input
                        type="password"
                        id="password"
                        name="password"
                        class="form-control"
                        placeholder="Enter current password"
                        required
                    >
                </div>

                <div class="mb-3">
                    <label class="form-label" for="new_password">
                        New Password
                    </label>

                    <input
                        type="password"
                        id="new_password"
                        name="new_password"
                        class="form-control"
                        placeholder="Enter new password"
                        required
                    >
                </div>

                <div class="mb-4">
                    <label class="form-label" for="confirm_password">
                        Confirm New Password
                    </label>

                    <input
                        type="password"
                        id="confirm_password"
                        name="confirm_password"
                        class="form-control"
                        placeholder="Confirm new password"
                        required
                    >
                </div>

                <button class="btn btn-primary w-100" type="submit">
                    <i class="bi bi-shield-lock me-2"></i>
                    Update Password
                </button>

            </form>

        </div>

    </div>

</div>

</body>
</html>

