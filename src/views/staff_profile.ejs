<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Staff Profile | Ease Cure Pharma</title>

    <link rel="stylesheet" href="/bootstrap/css/bootstrap.min.css">
    <link rel="stylesheet" href="/bootstrap-icons/bootstrap-icons.css">

    <style>
        body{
            background:#f4f7fc;
            font-family:'Segoe UI',sans-serif;
        }

        .profile-card{
            border:none;
            border-radius:20px;
            overflow:hidden;
            box-shadow:0 10px 30px rgba(0,0,0,.08);
        }

        .profile-header{
            background:linear-gradient(135deg,#2563EB,#1E3A8A);
            color:#fff;
            text-align:center;
            padding:40px 20px;
        }

        .profile-avatar{
            width:120px;
            height:120px;
            background:#fff;
            color:#2563EB;
            border-radius:50%;
            display:flex;
            justify-content:center;
            align-items:center;
            margin:auto;
            font-size:55px;
            border:5px solid rgba(255,255,255,.3);
        }

        .table th{
            color:#1E3A8A;
            width:35%;
        }

        .table td{
            color:#555;
        }

        .badge-role{
            font-size:.9rem;
            padding:8px 16px;
            border-radius:30px;
        }

        .action-btn{
            min-width:160px;
        }

    </style>

</head>

<body>
<%- include('./partials/sidebar.ejs')%>
<div class="container py-5">

    <div class="row justify-content-center">

        <div class="col-lg-7">

            <div class="card profile-card">

                <!-- Header -->

                <div class="profile-header">

                    <div class="profile-avatar">
                        <i class="bi bi-person-fill"></i>
                    </div>

                    <h2 class="mt-3 mb-1">
                        <%= staff.name %>
                    </h2>

                    <span class="badge bg-warning text-dark badge-role text-uppercase">
                        <%= staff.role %>
                    </span>

                </div>

                <!-- Body -->

                <div class="card-body p-4">

                    <table class="table table-borderless">

                        <tr>
                            <th>
                                <i class="bi bi-person-vcard me-2"></i>
                                Staff ID
                            </th>

                            <td>
                                <%= staff._id %>
                            </td>
                        </tr>

                        <tr>
                            <th>
                                <i class="bi bi-envelope me-2"></i>
                                Email
                            </th>

                            <td>
                                <%= staff.email %>
                            </td>
                        </tr>

                        <tr>
                            <th>
                                <i class="bi bi-cash-stack me-2"></i>
                                Salary
                            </th>

                            <td>
                                ₹ <%= Number(staff.salary).toLocaleString("en-IN") %>
                            </td>
                        </tr>

                        <tr>
                            <th>
                                <i class="bi bi-shield-check me-2"></i>
                                Role
                            </th>

                            <td>

                                <% if(staff.role==="admin"){ %>

                                    <span class="badge bg-danger badge-role">
                                        ADMIN
                                    </span>

                                <% }else{ %>

                                    <span class="badge bg-success badge-role">
                                       <%= staff.role%>
                                    </span>

                                <% } %>

                            </td>
                        </tr>

                        <tr>
                            <th>
                                <i class="bi bi-calendar-event me-2"></i>
                                Joined On
                            </th>

                            <td>
                                <%= new Date(staff.createdAt).toLocaleDateString("en-IN",{day:'numeric',month:'long',year:'numeric'}) %>
                            </td>
                        </tr>

                        <tr>
                            <th>
                                <i class="bi bi-clock-history me-2"></i>
                                Last Updated
                            </th>

                            <td>
                                <%= new Date(staff.updatedAt).toLocaleDateString("en-IN",{day:'numeric',month:'long',year:'numeric'}) %>
                            </td>
                        </tr>

                    </table>

                </div>

                <!-- Footer -->

                <div class="card-footer bg-white py-4">

                    <div class="d-flex flex-wrap justify-content-center gap-3">

                        <a href="/staff-table" class="btn btn-secondary action-btn">

                            <i class="bi bi-arrow-left-circle"></i>

                            Back

                        </a>

                        <a href="/staff/edit/<%= staff._id %>" class="btn btn-primary action-btn">

                            <i class="bi bi-pencil-square"></i>

                            Update Profile

                        </a>

                        <a href="/staff/delete/<%= staff._id %>"
                           class="btn btn-danger action-btn"
                           onclick="return confirm('Are you sure you want to delete this staff?')">

                            <i class="bi bi-trash"></i>

                            Delete Staff

                        </a>

                    </div>

                </div>

            </div>

        </div>

    </div>

</div>

<script src="/bootstrap/js/bootstrap.bundle.min.js"></script>

</body>
</html>