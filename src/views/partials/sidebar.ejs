<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1">

<title>Ease Cure Pharma</title>

<link rel="stylesheet" href="/bootstrap/css/bootstrap.min.css">
<link rel="stylesheet" href="/bootstrap-icons/bootstrap-icons.css">
<style>

body{
    background:#f4f7fc;
    font-family:'Segoe UI',sans-serif;
}

/* Desktop Sidebar */

.sidebar{
    width:270px;
    height:100vh;
    position:fixed;
    left:0;
    top:0;
    background:#1E3A8A;
    color:#fff;
    overflow-y:auto;
    transition:.3s;
}

.brand{
    background:#2563EB;
    text-align:center;
    padding:25px;
}

.brand i{
    width:70px;
    height:70px;
    display:flex;
    justify-content:center;
    align-items:center;
    margin:auto;
    background:#fff;
    color:#2563EB;
    border-radius:50%;
    font-size:32px;
    margin-bottom:15px;
}

.profile{
    text-align:center;
    padding:20px;
}

.profile img{
    width:70px;
    height:70px;
    border-radius:50%;
    border:3px solid #fff;
}

.profile h6{
    margin-top:12px;
}

.sidebar .nav-link{
    color:#dbeafe;
    padding:14px 20px;
    margin:6px 15px;
    border-radius:10px;
    transition:.3s;
    display:flex;
    align-items:center;
    gap:12px;
}

.sidebar .nav-link:hover,
.sidebar .nav-link.active{
    background:#fff;
    color:#2563EB;
}

.logout{
    padding:20px;
}

.main-content{
    margin-left:270px;
    padding:30px;
}

/* Mobile Navbar */

.mobile-navbar{
    display:none;
}

/* Mobile */

@media(max-width:992px){

.sidebar{
    display:none;
}

.main-content{
    margin-left:0;
    padding:20px;
}

.mobile-navbar{
    display:block;
}

}

</style>

</head>

<body>

<!-- Mobile Navbar -->

<nav class="navbar navbar-light bg-white shadow-sm d-lg-none mobile-navbar">

<div class="container-fluid">

<button class="btn btn-primary" data-bs-toggle="offcanvas" data-bs-target="#mobileSidebar">

<i class="bi bi-list"></i>

</button>

<span class="fw-bold text-primary">

<i class="bi bi-capsule-pill"></i>

Ease Cure Pharma

</span>

</div>

</nav>

<!-- Desktop Sidebar -->

<div class="sidebar d-none d-lg-block">

<div class="brand">

<i class="bi bi-capsule-pill"></i>

<h4>Ease Cure Pharma</h4>

<small>Pharmacy Billing System</small>

</div>



<ul class="nav flex-column mt-3">

<li><a href="/dashboard" class="nav-link "><i class="bi bi-speedometer2"></i>Dashboard</a></li>

<li><a href="#" class="nav-link"><i class="bi bi-receipt"></i>Billing</a></li>

<li><a href="#" class="nav-link"><i class="bi bi-people"></i>Customers</a></li>

<li><a href="#" class="nav-link"><i class="bi bi-capsule"></i>Medicines</a></li>

<li><a href="#" class="nav-link"><i class="bi bi-grid"></i>Categories</a></li>

<li><a href="#" class="nav-link"><i class="bi bi-truck"></i>Suppliers</a></li>

<li><a href="#" class="nav-link"><i class="bi bi-cart-check"></i>Purchase</a></li>

<li><a href="#" class="nav-link"><i class="bi bi-box-seam"></i>Inventory</a></li>

<li><a href="/add-staff" class="nav-link"><i class="bi bi-person-badge"></i> Register Staff</a></li>

<li><a href="/staff-table" class="nav-link"><i class="bi bi-bar-chart"></i>Staff Details</a></li>

<li><a href="#" class="nav-link"><i class="bi bi-gear"></i>Settings</a></li>

</ul>

<div class="logout">

<a href="/logout">
    <button class="btn btn-danger w-100">

<i class="bi bi-box-arrow-right"></i>

Logout

</button>
</a>

</div>

</div>

<!-- Mobile Sidebar -->

<div class="offcanvas offcanvas-start" tabindex="-1" id="mobileSidebar">

<div class="offcanvas-header bg-primary text-white">

<h5>

<i class="bi bi-capsule-pill"></i>

Ease Cure Pharma

</h5>

<button class="btn-close btn-close-white" data-bs-dismiss="offcanvas"></button>

</div>

<div class="offcanvas-body p-0">

<ul class="nav flex-column p-3">

<li><a href="/dashboard" class="nav-link active"><i class="bi bi-speedometer2 me-2"></i>Dashboard</a></li>

<li><a href="#" class="nav-link"><i class="bi bi-receipt me-2"></i>Billing</a></li>

<li><a href="#" class="nav-link"><i class="bi bi-people me-2"></i>Customers</a></li>

<li><a href="#" class="nav-link"><i class="bi bi-capsule me-2"></i>Medicines</a></li>

<li><a href="#" class="nav-link"><i class="bi bi-grid me-2"></i>Categories</a></li>

<li><a href="#" class="nav-link"><i class="bi bi-truck me-2"></i>Suppliers</a></li>

<li><a href="#" class="nav-link"><i class="bi bi-cart-check me-2"></i>Purchase</a></li>

<li><a href="#" class="nav-link"><i class="bi bi-box-seam me-2"></i>Inventory</a></li>

<li><a href="/add-staff" class="nav-link"><i class="bi bi-person-badge me-2"></i> Register Staff</a></li>

<li><a href="/staff-table" class="nav-link"><i class="bi bi-bar-chart me-2"></i>Staff Details</a></li>

<li><a href="#" class="nav-link"><i class="bi bi-gear me-2"></i>Settings</a></li>

</ul>

<div class="p-3">

<a href="/logout">
    <button class="btn btn-danger w-100">

<i class="bi bi-box-arrow-right me-2"></i>

Logout

</button>
</a>

</div>

</div>

</div>


<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.7/dist/js/bootstrap.bundle.min.js"></script>

</body>
</html>