<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    <title>Ease Cure Pharma</title>

    <link rel="stylesheet" href="/bootstrap/css/bootstrap.min.css" />
    <link rel="stylesheet" href="/bootstrap-icons/bootstrap-icons.css" />
    <style>
      body {
        background: #f4f7fc;
        font-family: "Segoe UI", sans-serif;
      }

      /* Desktop Sidebar */

      .sidebar {
        width: 270px;
        height: 100vh;
        position: fixed;
        left: 0;
        top: 0;
        background: linear-gradient(180deg, #1e3a8a 0%, #172554 100%);
        color: #fff;
        overflow-y: auto;
        transition: 0.3s;
        box-shadow: 2px 0 18px rgba(0, 0, 0, 0.15);
      }

      .brand {
        background: linear-gradient(135deg, #2563eb 0%, #1d4ed8 100%);
        text-align: center;
        padding: 24px 18px;
      }

      .brand i {
        width: 70px;
        height: 70px;
        display: flex;
        justify-content: center;
        align-items: center;
        margin: auto;
        background: #fff;
        color: #2563eb;
        border-radius: 50%;
        font-size: 32px;
        margin-bottom: 12px;
      }

      .brand .brand-title {
        font-size: 1.05rem;
        font-weight: 700;
        margin-bottom: 2px;
      }

      .brand .brand-subtitle {
        font-size: 0.82rem;
        color: #dbeafe;
      }

      .sidebar .nav {
        padding: 10px 10px 0;
      }

      .sidebar .nav-link {
        color: #dbeafe;
        padding: 12px 14px;
        margin: 4px 0;
        border-radius: 12px;
        transition: 0.3s;
        display: flex;
        align-items: center;
        gap: 10px;
        font-size: 0.95rem;
        text-decoration: none;
      }

      .sidebar .nav-link .menu-text {
        display: flex;
        flex-direction: column;
        line-height: 1.2;
      }

      .sidebar .nav-link .menu-text small {
        font-size: 0.72rem;
        color: #bfdbfe;
        margin-top: 2px;
      }

      .sidebar .nav-link:hover,
      .sidebar .nav-link.active {
        background: #fff;
        color: #2563eb;
      }

      .sidebar .nav-link:hover .menu-text small,
      .sidebar .nav-link.active .menu-text small {
        color: #2563eb;
      }

      .logout {
        padding: 20px 14px 24px;
      }

      .main-content {
        margin-left: 270px;
        padding: 30px;
      }

      .mobile-navbar {
        display: none;
      }

      .offcanvas {
        width: 280px;
      }

      .offcanvas .nav-link {
        color: #1e3a8a;
        padding: 12px 14px;
        border-radius: 10px;
        margin-bottom: 6px;
        display: flex;
        align-items: center;
        gap: 10px;
      }

      .offcanvas .nav-link:hover,
      .offcanvas .nav-link.active {
        background: #dbeafe;
        color: #1d4ed8;
      }

      @media (max-width: 992px) {
        .sidebar {
          display: none;
        }

        .main-content {
          margin-left: 0;
          padding: 20px;
        }

        .mobile-navbar {
          display: block;
        }
      }
    </style>
  </head>

  <body>
    <!-- Mobile Navbar -->

    <nav class="navbar navbar-light bg-white shadow-sm d-lg-none mobile-navbar">
      <div class="container-fluid">
        <button
          class="btn btn-primary"
          data-bs-toggle="offcanvas"
          data-bs-target="#mobileSidebar"
        >
          <i class="bi bi-list"></i>
        </button>

        <span class="fw-bold text-primary d-flex align-items-center gap-2">
          <i class="bi bi-capsule-pill fs-5"></i>
          <span>Ease Cure Pharma</span>
        </span>
      </div>
    </nav>

    <!-- Desktop Sidebar -->

    <div class="sidebar d-none d-lg-block">
      <div class="brand">
        <i class="bi bi-capsule-pill"></i>

        <h4 class="brand-title">Ease Cure Pharma</h4>

        <div class="brand-subtitle">Pharmacy Billing System</div>
      </div>

      <ul class="nav flex-column mt-3">
        <li>
          <a href="/dashboard" class="nav-link active"
            ><i class="bi bi-speedometer2"></i>
            <span class="menu-text">
              Dashboard
              <small>ড্যাশবোর্ড</small>
            </span>
          </a>
        </li>

        <li>
          <a href="/billing" class="nav-link"
            ><i class="bi bi-receipt"></i>
            <span class="menu-text">
              Billing
              <small>বিলিং</small>
            </span></a
          >
        </li>

        <li>
          <a href="/customer" class="nav-link"
            ><i class="bi bi-people"></i>
            <span class="menu-text">
              Customers
              <small>গ্রাহক</small>
            </span></a
          >
        </li>

        <li>
          <a href="/stock" class="nav-link"
            ><i class="bi bi-capsule"></i>
            <span class="menu-text">
              Medicines
              <small>ওষুধ</small>
            </span></a
          >
        </li>

        <li>
          <a href="/stock-add" class="nav-link"
            ><i class="bi bi-box-seam"></i>
            <span class="menu-text">
              Stock Entry
              <small>স্টক এন্ট্রি</small>
            </span></a
          >
        </li>

        <li>
          <a href="/add-staff" class="nav-link"
            ><i class="bi bi-person-badge"></i>
            <span class="menu-text">
              Staff Register
              <small>কর্মচারী নিবন্ধন</small>
            </span></a
          >
        </li>

        <li>
          <a href="/staff-table" class="nav-link"
            ><i class="bi bi-people-fill"></i>
            <span class="menu-text">
              Staff List
              <small>কর্মচারী তালিকা</small>
            </span></a
          >
        </li>

        <li>
          <a href="#" class="nav-link"
            ><i class="bi bi-gear"></i>
            <span class="menu-text">
              Settings
              <small>সেটিংস</small>
            </span></a
          >
        </li>
      </ul>

      <div class="logout">
        <a href="/logout">
          <button class="btn btn-danger w-100">
            <i class="bi bi-box-arrow-right"></i>

            Logout(লগআউট)
          </button>
        </a>
      </div>
    </div>

    <!-- Mobile Sidebar -->

    <div class="offcanvas offcanvas-start" tabindex="-1" id="mobileSidebar">
      <div class="offcanvas-header bg-primary text-white">
        <h5>
          <i class="bi bi-capsule-pill"></i>

          Ease Cure Pharma
        </h5>

        <button
          class="btn-close btn-close-white"
          data-bs-dismiss="offcanvas"
        ></button>
      </div>

      <div class="offcanvas-body p-0">
        <ul class="nav flex-column p-3">
          <li>
            <a href="/dashboard" class="nav-link active"
              ><i class="bi bi-speedometer2 me-2"></i>Dashboard</a
            >
          </li>

          <li>
            <a href="/billing" class="nav-link"
              ><i class="bi bi-receipt me-2"></i>Billing</a
            >
          </li>

          <li>
            <a href="/customer" class="nav-link"
              ><i class="bi bi-people me-2"></i>Customers</a
            >
          </li>

          <li>
            <a href="#" class="nav-link"
              ><i class="bi bi-capsule me-2"></i>Medicines</a
            >
          </li>

          <li>
            <a href="#" class="nav-link"
              ><i class="bi bi-grid me-2"></i>Categories</a
            >
          </li>

          <li>
            <a href="#" class="nav-link"
              ><i class="bi bi-truck me-2"></i>Suppliers</a
            >
          </li>

          <li>
            <a href="#" class="nav-link"
              ><i class="bi bi-cart-check me-2"></i>Purchase</a
            >
          </li>

          <li>
            <a href="/stock-add" class="nav-link"
              ><i class="bi bi-box-seam me-2"></i>Inventory</a
            >
          </li>

          <li>
            <a href="/add-staff" class="nav-link"
              ><i class="bi bi-person-badge me-2"></i> Register Staff</a
            >
          </li>

          <li>
            <a href="/staff-table" class="nav-link"
              ><i class="bi bi-bar-chart me-2"></i>Staff Details</a
            >
          </li>

          <li>
            <a href="#" class="nav-link"
              ><i class="bi bi-gear me-2"></i>Settings</a
            >
          </li>
        </ul>

        <div class="p-3">
          <a href="/logout" class="text-decoration-none">
            <button class="btn btn-danger w-100">
              <i class="bi bi-box-arrow-right me-2"></i>
              Logout (লগআউট)
            </button>
          </a>
        </div>
      </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.7/dist/js/bootstrap.bundle.min.js"></script>
  </body>
</html>
