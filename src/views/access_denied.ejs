<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Access Denied</title>

    <!-- Bootstrap -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.7/dist/css/bootstrap.min.css" rel="stylesheet">

    <!-- Bootstrap Icons -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.13.1/font/bootstrap-icons.min.css">

    <style>
        body {
            background: linear-gradient(135deg, #0f172a, #1e3a8a, #2563eb);
            min-height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
            font-family: "Segoe UI", Arial, sans-serif;
            padding: 20px;
        }

        .access-card {
            max-width: 680px;
            width: 100%;
            border: none;
            border-radius: 24px;
            overflow: hidden;
            box-shadow: 0 20px 50px rgba(0,0,0,.28);
            animation: fadeIn .7s ease;
            background: #ffffff;
        }

        .card-head {
            background: linear-gradient(135deg, #fef2f2, #fee2e2);
            padding: 30px 20px 20px;
        }

        .icon {
            font-size: 88px;
            color: #dc3545;
        }

        .code {
            font-size: 72px;
            font-weight: 800;
            color: #dc3545;
            letter-spacing: 1px;
        }

        .title {
            font-size: 1.8rem;
            font-weight: 700;
            color: #0f172a;
        }

        .subtitle {
            font-size: 1rem;
            color: #475569;
            margin-top: 8px;
        }

        .bengali {
            color: #2563eb;
            font-weight: 600;
            margin-top: 6px;
        }

        .btn-custom {
            padding: 12px 24px;
            border-radius: 50px;
            font-weight: 600;
        }

        @keyframes fadeIn {
            from {
                opacity: 0;
                transform: translateY(30px);
            }
            to {
                opacity: 1;
                transform: translateY(0);
            }
        }
    </style>
</head>
<body>

<div class="card access-card text-center">

    <div class="card-head">
        <div class="mb-3">
            <i class="bi bi-shield-lock-fill icon"></i>
        </div>

        <h1 class="code">403</h1>

        <h2 class="title mt-2">Access Denied</h2>
        <div class="bengali">অ্যাক্সেস অস্বীকৃত</div>

        <p class="subtitle mt-3">
            Sorry, you do not have permission to access this page.
        </p>
        <p class="text-muted mb-0">
            দুঃখিত, এই পেজটি দেখার অনুমতি আপনার নেই।
        </p>
    </div>

    <div class="p-4 p-md-5">
        <p class="text-secondary mb-4">
            This area is restricted to authorized users only. Please contact the administrator if you think this is a mistake.
        </p>
        <p class="text-secondary mb-4">
            এই অংশটি কেবল অনুমোদিত ব্যবহারকারীদের জন্য। যদি মনে করেন এটি ভুল হয়েছে, তাহলে প্রশাসকের সঙ্গে যোগাযোগ করুন।
        </p>

        <div class="d-flex flex-column flex-md-row justify-content-center gap-3 mt-3">
            <a href="/dashboard" class="btn btn-primary btn-custom">
                <i class="bi bi-speedometer2 me-2"></i>
                Dashboard
            </a>

            <a href="/" class="btn btn-outline-dark btn-custom">
                <i class="bi bi-box-arrow-in-right me-2"></i>
                Login
            </a>
        </div>
    </div>

</div>

</body>
</html>